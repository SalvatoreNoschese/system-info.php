root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# PHP, CSS and JavaScript (all inside system-info.php): four spaces, PSR-12.
# Shell scripts keep the tabs above.
[*.php]
indent_style = space

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
